DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.risegeouae\.ae$ [NC]
RewriteRule ^ https://risegeouae.ae%{REQUEST_URI} [L,R=301]
AddType text/plain .txt
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
</IfModule>
# BEGIN v1 redirects
Redirect 301 /category/association-and-education.html /section/institutions-community.html
Redirect 301 /category/drone-and-uav-services.html /category/drone-survey-and-mapping-companies.html
Redirect 301 /category/gis-and-consulting.html /category/gis-consultants.html
Redirect 301 /category/government-and-agency.html /category/national-mapping-and-survey-agencies.html
Redirect 301 /category/hardware-supplier.html /section/products-equipment.html
Redirect 301 /category/hydrographic-and-marine.html /category/hydrographic-and-bathymetric-surveys.html
Redirect 301 /category/satellite-and-earth-observation.html /category/satellite-imagery-providers.html
Redirect 301 /category/software-vendor.html /section/software-data.html
Redirect 301 /category/survey-company.html /category/land-surveyors.html
Redirect 301 /company/rise-geo.html /company/rise-geo-control-systems-trading.html
# END v1 redirects
